{
  "name": "roadbook",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev:weapp": "concurrently --kill-others \"pnpm run tw:watch\" \"taro build --type weapp --watch\"",
    "build:weapp": "pnpm run tw:build && taro build --type weapp",
    "tw:build": "tailwindcss -i src/tailwind.input.css -o src/tailwind.generated.css",
    "tw:watch": "tailwindcss -i src/tailwind.input.css -o src/tailwind.generated.css --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "postinstall": "weapp-tw patch"
  },
  "dependencies": {
    "@babel/runtime": "7.24.4",
    "@roadbook/monitor": "workspace:*",
    "@roadbook/types": "workspace:*",
    "@tarojs/components": "4.2.0",
    "@tarojs/plugin-framework-react": "4.2.0",
    "@tarojs/plugin-platform-weapp": "4.2.0",
    "@tarojs/react": "4.2.0",
    "@tarojs/runtime": "4.2.0",
    "@tarojs/shared": "4.2.0",
    "@tarojs/taro": "4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/preset-react": "7.28.5",
    "@roadbook/config": "workspace:*",
    "@tarojs/cli": "4.2.0",
    "@tarojs/vite-runner": "4.2.0",
    "@types/react": "18.3.23",
    "@vitejs/plugin-react": "4.3.0",
    "babel-preset-taro": "4.2.0",
    "concurrently": "^10.0.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3",
    "vite": "4.2.0",
    "weapp-tailwindcss": "^4.12.0"
  }
}
